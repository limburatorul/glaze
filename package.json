{
  "name": "glaze",
  "productName": "Glaze",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "build": {
    "appId": "app.protagonistlabs.glaze",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "style.css",
      "background.*",
      "extensions/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Glaze-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Glaze-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "limburatorul",
      "repo": "glaze",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "description": "A desktop player for YouTube on Windows: frosted glass, a player that fills the window, SponsorBlock built in.",
  "author": "Protagonist Labs",
  "license": "GPL-3.0-only",
  "homepage": "https://protagonistlabs.app/glaze/",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
