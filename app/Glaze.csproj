<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Glaze</AssemblyName>
    <RootNamespace>Glaze</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Glaze</Product>
    <Company>Protagonist Labs</Company>
    <ApplicationIcon>..\build\icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- The page files and SponsorBlock travel inside the exe, so the portable build is one file.
       Resources.Extract unpacks them next to the WebView2 data when the version changes. -->
  <ItemGroup>
    <EmbeddedResource Include="..\style.css;..\settings.html;..\background.png;page.js" LogicalName="web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\extensions\**\*" LogicalName="ext/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
